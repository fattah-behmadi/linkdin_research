# Copy to backend/.env and adjust as needed.

# sql = SQLite + FTS5 (no Docker needed) | elasticsearch = Elasticsearch 8
SEARCH_BACKEND=sql

# Defaults to <repo>/data/linkedin.db; override only to move the database.
# DATABASE_URL=sqlite+aiosqlite:///C:/path/to/linkedin.db

ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=linkedin-profiles

CORS_ORIGINS=["http://localhost:3000"]
DEBUG=false
